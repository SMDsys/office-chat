# Windows-скрипты и инструкция должны попадать в релизный архив с CRLF:
# иначе cmd.exe и старый «Блокнот» могут показать файл одной строкой.
*.bat text eol=crlf
*.txt text eol=crlf

*.go   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
